# Existing Discord webhook, server-only. Never prefix secrets with NEXT_PUBLIC_.
DISCORD_WEBHOOK_URL=
# Optional: share spam counters and duplicate checks across server instances.
# Submissions work with DISCORD_WEBHOOK_URL alone; no Redis setup is required.
# Upstash Redis and Vercel's KV_REST_API_URL / KV_REST_API_TOKEN aliases are supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_SITE_URL=https://randomstuff.shocka.site
